+            const bool vendorNeedsDepthLoad = device->physicalDeviceProperties.vendorID == 0x1010;
+            const bool preferNoneForReadOnly = desc.depthAttachmentReadOnly && device->loadStoreOpNoneSupported && !vendorNeedsDepthLoad;
             VkAttachmentDescription attachment = {};
             attachment.format = toVk(depthAttachmentViewDesc.format);
