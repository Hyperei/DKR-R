+            // Imagination's tile-based deferred renderer runs fragment shading
+            // for a frame after, and overlapped with, the vertex work of the
+            // next. Anything the fragment phase reads that the host has since
+            // rewritten - texture contents, update-after-bind descriptor slots -
+            // comes out wrong: geometry was consumed early and is correct,
+            // colour and texture were consumed late and are not. Completing
+            // each submission before the next closes that window. Confirmed on
+            // a Pixel 10 (PowerVR DXT-48-1536): a full race with no corruption
+            // where every other change left it unaffected. Other vendors keep
+            // their asynchronous behaviour.
+            if (res == VK_SUCCESS && device->physicalDeviceProperties.vendorID == 0x1010) {
+                vkQueueWaitIdle(queue->vk);
+            }
