+// Native framebuffer pixels through a 32-bit structured buffer. The texel
+// buffer views this replaces are bounded by maxTexelBufferElements, which
+// some devices expose at the 65536 minimum; a 320x240 16-bit framebuffer is
+// 76800 pixels on its own, and everything past the limit reads undefined.
+// Each pixel is unpacked from, or masked into, its share of a 32-bit word.
+uint FbLoadNative(StructuredBuffer<uint> source, uint pixelIndex, uint siz) {
+    switch (siz) {
+    case G_IM_SIZ_32b:
+        return source[pixelIndex];
+    case G_IM_SIZ_16b:
+        return (source[pixelIndex >> 1u] >> ((pixelIndex & 1u) * 16u)) & 0xFFFFu;
+    default: // 8-bit; 4-bit framebuffers are addressed per byte as well.
+        return (source[pixelIndex >> 2u] >> ((pixelIndex & 3u) * 8u)) & 0xFFu;
+    }
+}
+
+// Threads sharing a word only ever clear and set their own bits, so the
+// two atomics interleave safely with a neighbour doing the same.
+void FbStoreNative(RWStructuredBuffer<uint> target, uint pixelIndex, uint siz, uint value) {
+    switch (siz) {
+    case G_IM_SIZ_32b:
+        target[pixelIndex] = value;
+        break;
+    case G_IM_SIZ_16b: {
+        const uint shift = (pixelIndex & 1u) * 16u;
+        InterlockedAnd(target[pixelIndex >> 1u], ~(0xFFFFu << shift));
+        InterlockedOr(target[pixelIndex >> 1u], (value & 0xFFFFu) << shift);
+        break;
+    }
+    default: {
+        const uint shift = (pixelIndex & 3u) * 8u;
+        InterlockedAnd(target[pixelIndex >> 2u], ~(0xFFu << shift));
+        InterlockedOr(target[pixelIndex >> 2u], (value & 0xFFu) << shift);
+        break;
+    }
+    }
+}
