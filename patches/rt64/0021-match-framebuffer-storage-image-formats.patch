-Buffer<uint> gNewInput : register(t1, space0);
-Buffer<uint> gCurInput : register(t2, space0);
+// The views bound to these descriptors are chosen at runtime, so no literal
+// format declaration can match them. gNewInput/gCurInput follow the
+// framebuffer bit depth (R8/R16/R32_UINT), and the colour and depth change
+// targets are the same image: RGBA8 or an HDR format for a colour pool,
+// R32_FLOAT for a depth pool. A storage image whose declared format differs
+// from its view yields undefined values across the whole image, so declare
+// them unformatted. gOutputChangeBoolean is always R8_UINT and can say so.
+[[vk::image_format("unknown")]] Buffer<uint> gNewInput : register(t1, space0);
+[[vk::image_format("unknown")]] Buffer<uint> gCurInput : register(t2, space0);
 RWStructuredBuffer<uint> gOutputCount : register(u3, space0);
-RWTexture2D<float4> gOutputChangeColor : register(u0, space1);
-RWTexture2D<float> gOutputChangeDepth : register(u1, space1);
-RWTexture2D<uint> gOutputChangeBoolean : register(u2, space1);
+[[vk::image_format("unknown")]] RWTexture2D<float4> gOutputChangeColor : register(u0, space1);
+[[vk::image_format("unknown")]] RWTexture2D<float> gOutputChangeDepth : register(u1, space1);
+[[vk::image_format("r8ui")]] RWTexture2D<uint> gOutputChangeBoolean : register(u2, space1);
 
