+// These are per-vertex attribute buffers for an entire workload, which can
+// reach hundreds of thousands of elements. A texel buffer view is limited to
+// maxTexelBufferElements, and the Vulkan specification permits that to be as
+// low as 65536 - PowerVR reports exactly the minimum. Storage buffers carry no
+// such element limit, so read these as structured buffers instead.
+StructuredBuffer<float> srcPos : register(t1);
+StructuredBuffer<float> srcVel : register(t2);
+StructuredBuffer<float> srcTc : register(t3);
+StructuredBuffer<float> srcTcVel : register(t4);
+// One packed RGBA8 element per vertex, read as colour through srcCol and as
+// signed normals through srcNorm. The texel buffer views widened each byte on
+// the hardware; unpack by hand now.
+StructuredBuffer<uint> srcCol : register(t5);
+StructuredBuffer<uint> srcNorm : register(t6);
+
+uint RSPUnpackByte(uint packed, uint byteIndex) {
+    return (packed >> (byteIndex * 8u)) & 0xFFu;
+}
+
+float RSPUnpackSNorm8(uint packed, uint byteIndex) {
+    // Branchless sign extension of an 8-bit value.
+    return (int(RSPUnpackByte(packed, byteIndex) ^ 0x80u) - 128) / 127.0f;
+}
+
+float RSPUnpackUNorm8(uint packed, uint byteIndex) {
+    return RSPUnpackByte(packed, byteIndex) / 255.0f;
+}
