+// Per-vertex buffers for a whole workload, which run past
+// maxTexelBufferElements. Read them as storage buffers, which have no
+// equivalent limit, and unpack the narrow entries by hand.
+StructuredBuffer<float> srcPos : register(t1);
+StructuredBuffer<float> srcVel : register(t2);
+StructuredBuffer<uint> srcNorm : register(t3);
+StructuredBuffer<uint> srcIndices : register(t4);
+
+float RSPWorldSByte(uint packed, uint byteIndex) {
+    const uint value = (packed >> (byteIndex * 8u)) & 0xFFu;
+    // Branchless sign extension of an 8-bit value.
+    return float(int(value ^ 0x80u) - 128);
+}
+
+uint RSPWorldU16(StructuredBuffer<uint> source, uint index) {
+    return (source[index >> 1u] >> ((index & 1u) * 16u)) & 0xFFFFu;
+}
 StructuredBuffer<float4x4> worldMats : register(t5);
 StructuredBuffer<float4x4> invTWorldMats : register(t6);
